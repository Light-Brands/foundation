# The only value a deploy needs. 6 to 12 digits. Keep it private.
FOUNDATION_PIN=
# Optional. Set by `npm run setup` for local runs. If unset, everyone is signed out after each new build or restart.
FOUNDATION_SECRET=
FOUNDATION_BUSINESS_NAME=
# Optional. Where the local database lives. Defaults to .data/pglite
FOUNDATION_DATA_DIR=
