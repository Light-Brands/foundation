# The only value a deploy needs. 6 to 12 digits. Keep it private.
FOUNDATION_PIN=
# Set by `npm run setup` for local runs. If unset, everyone is signed out after each new build or restart,
# and no opt-out can be recorded or checked, so no customer email is sent.
# Keep it the same for the life of your Foundation: a new value makes every earlier opt-out unmatchable.
# At least 32 characters. A shorter value counts as unset for opt-outs.
FOUNDATION_SECRET=
FOUNDATION_BUSINESS_NAME=
# Optional. Where the local database lives. Defaults to .data/pglite
FOUNDATION_DATA_DIR=
# Optional. Lets your host run your checks on a schedule once your database is connected.
# At least 16 characters. Your host sends it with each scheduled call.
CRON_SECRET=
# Optional. Your live site's https address, like https://command.yourbusiness.com. Marketing email
# needs it for its unsubscribe link. On Vercel your production address is used when this is empty.
FOUNDATION_URL=
# Optional. Your hosted database (Supabase), from Project settings, then Database, then Connection pooling,
# in transaction mode on port 6543. When set, your command center and your commands save there.
FOUNDATION_DATABASE_URL=
# Optional. Sign in by email: your Supabase project address and its secret API key (it starts sb_secret_).
# Keep the key private. Email sign-in also needs FOUNDATION_SECRET set above.
FOUNDATION_SUPABASE_URL=
FOUNDATION_SUPABASE_SECRET_KEY=
