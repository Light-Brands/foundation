{
  "name": "foundation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/gen-build-secret.mjs",
    "build": "next build",
    "predev": "node scripts/gen-build-secret.mjs",
    "dev": "next dev -H 127.0.0.1",
    "start": "next start -H 127.0.0.1",
    "pretest": "node scripts/gen-build-secret.mjs",
    "test": "vitest run",
    "pretypecheck": "node scripts/gen-build-secret.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "e2e": "playwright test",
    "setup": "node scripts/setup.mjs",
    "key:sync": "tsx scripts/key-sync.ts",
    "log:sync": "tsx scripts/log-sync.ts",
    "log:base": "tsx scripts/log-base.ts",
    "predraft": "node scripts/gen-build-secret.mjs",
    "draft": "tsx --conditions=react-server scripts/draft.ts",
    "hooks:prune": "tsx scripts/hooks-prune.ts",
    "preoutbox:send": "node scripts/gen-build-secret.mjs",
    "outbox:send": "tsx --conditions=react-server scripts/outbox-send.ts",
    "preconnection:set": "node scripts/gen-build-secret.mjs",
    "connection:set": "tsx --conditions=react-server scripts/connection-set.ts",
    "preperson": "node scripts/gen-build-secret.mjs",
    "person": "tsx --conditions=react-server scripts/person.ts",
    "prechief": "node scripts/gen-build-secret.mjs",
    "chief": "tsx --conditions=react-server scripts/chief.ts",
    "preauth:unlock": "node scripts/gen-build-secret.mjs --if-missing",
    "auth:unlock": "tsx --conditions=react-server scripts/auth-unlock.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@next/env": "16.3.8",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "postgres": "^3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "server-only": "^0.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
